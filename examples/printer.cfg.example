# Minimal example of how the pieces fit together on a tool changer based on klipper-toolchanger.
# Merge this into your own printer.cfg, do not copy it over.

[include mosaic/mosaic.cfg]
[include mosaic/examples/mosaic_hardware.cfg]

# Docking: pick-up / drop-off for passive (Maxwell / kinematic) couplings.
# The engine comes from this package; the positions file is yours and lives next to
# printer.cfg (install.sh creates it), so updating MOSAIC never touches it.
# Leave both out if your changer brings its own dock macros.
[include mosaic/mosaic_dock.cfg]
[include mosaic_dock_positions.cfg]

# Optional: T0 ... T9 commands, per tool heater handling and the tools page.
# It must come BEFORE the [tool Tn] sections, or Klipper stops with
# "gcode command T0 already registered".
[include mosaic/mosaic_tools.cfg]
# Optional: M104 / M109 with a T parameter (slicer lines such as "M104 T1 S220").
# Not together with beacon_heater_hooks.cfg, both define M104 and M109 and the one included last wins.
#[include mosaic/mosaic_tool_heaters.cfg]

# Only the settings that differ from the defaults. This section must come AFTER the include.
[gcode_macro _MOSAIC_SETTINGS]
variable_reference_tool: 0
# tool_parameter for klipper-toolchanger 2025.12.26 or newer,
# gcode_offset if your tool change macros call SET_GCODE_OFFSET from t<N>_offset_x/y/z
variable_offset_method: 'tool_parameter'
# Where the nozzle of the reference tool hangs just above the middle of the
# Nudge pin (gcode coordinates). The nozzle tip must be well above the pin.
# 1 to 2 mm off is fine, the probing finds the centre itself.
variable_nudge_x: 150.0
variable_nudge_y: 5.0
variable_nudge_z: 15.0
variable_safe_z: 30.0
# 0 = measure cold. 150 = heat every nozzle to 150 C first.
variable_cal_temp: 0
# Only with a separate Z switch ([mosaic_z_probe] in the hardware file):
#variable_z_switch_x: 60.0
#variable_z_switch_y: 20.0

# Optional, only with mosaic_tools.cfg:
# [gcode_macro _MOSAIC_TOOLS_SETTINGS]
# variable_standby_mode: 'standby'   # a tool that is put away goes to standby_temp
# variable_standby_temp: 150.0
# variable_wait_on_select: True

# Hotend swapper with one shared extruder: every tool has its own heater and fan.
# The tool sections come AFTER the includes above.
#[extruder]
#...the one extruder with the stepper, see the note about min_extrude_temp in README.md
#
#[heater_generic hotend0]
#...heater_pin, sensor_type, sensor_pin, control, min_temp, max_temp
#[fan_generic fan0]
#pin: ...
#
#[tool T0]
#tool_number: 0
#heater: heater_generic hotend0
#fan: fan_generic fan0
#
# (repeat for T1 ... T9)
# The tools do NOT need their own pickup_gcode / dropoff_gcode, they use the
# ones in [toolchanger] below. An own line (even an empty "pickup_gcode:")
# overrides it.

# The dock hooks. Keep your other [toolchanger] options.
# The long {% if %} parts hand over the position the print was at, so that the
# dock macros can go back there safely (sideways at safe height, then down).
[toolchanger]
pickup_gcode:
    MOSAIC_DOCK_PICKUP T={tool.tool_number}{% if 'X' in restore_position %} RX={restore_position.X}{% endif %}{% if 'Y' in restore_position %} RY={restore_position.Y}{% endif %}{% if 'Z' in restore_position %} RZ={restore_position.Z}{% endif %}
dropoff_gcode:
    MOSAIC_DOCK_DROPOFF T={tool.tool_number}{% if pickup_tool is none %}{% if 'X' in restore_position %} RX={restore_position.X}{% endif %}{% if 'Y' in restore_position %} RY={restore_position.Y}{% endif %}{% if 'Z' in restore_position %} RZ={restore_position.Z}{% endif %}{% endif %}

# Tool switches. Pressed = tool present (add ! to the pin if yours is the other way).
# The names are fixed, see docs/docking.md "Tool switches". Replace the pins with yours.

# One switch on the carriage, pressed while any tool is attached.
# release_gcode pauses a running print if the tool falls off.
[gcode_button mosaic_head]
pin: ^PA1
debounce_delay: 0.1
press_gcode:
release_gcode:
    MOSAIC_DOCK_HEAD_RELEASED

# One switch per dock, pressed while its tool sits in the dock.
[gcode_button mosaic_dock_t0]
pin: ^PA2
debounce_delay: 0.1
press_gcode:

[gcode_button mosaic_dock_t1]
pin: ^PA3
debounce_delay: 0.1
press_gcode:

# ... and so on for the other tools: mosaic_dock_t2 to mosaic_dock_t9

# Calibrate everything: home first, then
#   MOSAIC_CALIBRATE
#
# Optional: measure only Z at every print start. Call this after G28 in PRINT_START.
#   MOSAIC_AUTO_Z_OFFSET
